{
  "name": "arkad",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ARKAD, une borne de petits jeux, un seul code pour le web et Android",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "dev": "node build.mjs && npx --yes http-server -p 8000 -c-1",
    "android": "node build.mjs && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
